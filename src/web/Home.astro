---
import Base from "@/layouts/Base.astro";
import WebIslands from "@/web/WebIslands";
import MerchRequest from "@/web/MerchRequest";
import { loadSiteData } from "@/web/siteData";
import { Icon, Punto } from "@/components/ui/icons";
import { platforms, socials, single, bio, contactEmail } from "@/web/content";
import { dateLabel, dayNum, mon, eur, isPast } from "@/lib/format";
import type { Gig } from "@/data/types";

/* En el build se leen los bolos publicados (seed o Supabase, ver siteData). */
const db = await loadSiteData();
/* La web entera. `empty` la enseña sin fechas ni merch (solo en /vacio,
   que existe en desarrollo) para revisar cómo queda. */
interface Props { empty?: boolean }
const { empty = false } = Astro.props;
const published = db.gigs.filter(g => g.published && g.status !== "cancelado");
/* Los bolos en secreto (teaser) solo traen lo desvelado; sin fecha van al final. */
const upcoming = empty ? [] : published.filter(g => !g.date || !isPast(g.date)).sort((a, b) => (a.date || "9999").localeCompare(b.date || "9999"));
const past = published.filter(g => g.date && !g.teaser && isPast(g.date)).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 2);
const eventOf = (gigId: string) => db.events.find(e => e.gigId === gigId);

const rows = [...upcoming, ...past].map(g => {
  const ev = eventOf(g.id);
  /* Sold out: marcado a mano en la suite o, con venta propia, sin plazas libres. */
  const soldOut = !g.teaser && !isPast(g.date) && (!!g.soldOut || (g.ticketing === "propia" && (ev as { free?: number } | undefined)?.free === 0));
  const own = !g.teaser && g.ticketing === "propia" && ev && !isPast(g.date) && !soldOut;
  return { g, ev, own, soldOut, past: isPast(g.date) };
});
/* El próximo concierto, venda entradas besta o no. */
const next = rows.find(r => !r.past);
/* Para «lo quiero»: el producto en el build y los conciertos donde se puede recoger. */
const merchProducts = empty ? [] : db.products.filter(p => p.published && !p.archived);
const pickupGigs = upcoming.filter(g => !g.teaser).map(g => ({ id: g.id, city: g.city, date: g.date }));

const islandEvents = db.events.map(e => {
  const g = db.gigs.find(x => x.id === e.gigId)!;
  return { id: e.id, name: e.name, city: g.city, venue: g.venue, date: g.date, time: g.time, priceCents: e.priceCents, maxPerOrder: e.maxPerOrder, image: e.image ?? "/img/escenario-azul.jpg" };
});

/* El teletipo: trozos de texto separados por un asterisco dibujado. */
const tickerGig = (g: Gig) => {
  const t = g.teaser;
  const when = !t || t.date === "exacta" ? `${dayNum(g.date)} ${mon(g.date)}` : t.date === "mes" ? mon(g.date) : "fecha secreta";
  return `${when} ${g.city ? g.city.toUpperCase() : "???"}`;
};
const ticker = ["besta en directo", ...(upcoming.length ? upcoming.map(tickerGig) : ["nuevas fechas muy pronto"]), `nuevo single «${single.title}»`];
/* Lo que aún no se ha desvelado: un texto de relleno borroso (el dato real no llega a la web). */
const secretWhen = (g: Gig) => g.teaser?.date === "mes" ? mon(g.date) : null;

/* Datos estructurados: quién es besta (Google, panel de conocimiento y
   asistentes de IA), la web, el single y cada concierto con su venta. */
const SITE = "https://besta.es";
const band = { "@id": `${SITE}/#besta` };
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MusicGroup", ...band, name: "besta", alternateName: "BESTA", url: SITE,
      description: bio,
      genre: ["Pop rock", "Pop"],
      foundingLocation: { "@type": "Place", name: "Barcelona, España" },
      logo: `${SITE}/img/logo-crema.png`,
      image: [`${SITE}/img/grupo.jpg`, `${SITE}/img/og.jpg`],
      email: contactEmail,
      sameAs: [...platforms, ...socials].map(p => p.url),
      track: { "@type": "MusicRecording", name: single.title, byArtist: band, url: single.spotify, image: `${SITE}${single.cover}` },
    },
    { "@type": "WebSite", "@id": `${SITE}/#web`, name: "besta", url: SITE, inLanguage: "es-ES", publisher: band },
    ...upcoming.filter(g => !g.teaser).map(g => {
      const ev = eventOf(g.id);
      return {
        "@type": "MusicEvent", name: `besta en ${g.city}`, startDate: `${g.date}T${g.time}:00+01:00`,
        eventStatus: "https://schema.org/EventScheduled", eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
        location: { "@type": "Place", name: g.venue, address: g.address ?? g.city },
        image: `${SITE}/img/og.jpg`,
        performer: band, organizer: band,
        ...(ev && g.ticketing === "propia" ? { offers: { "@type": "Offer", price: (ev.priceCents / 100).toFixed(2), priceCurrency: "EUR", availability: g.soldOut || (ev as { free?: number }).free === 0 ? "https://schema.org/SoldOut" : "https://schema.org/InStock", url: `${SITE}/#directo` } } : {}),
        ...(g.ticketing !== "propia" && g.externalUrl ? { offers: { "@type": "Offer", url: g.externalUrl } } : {}),
      };
    }),
  ],
};
---
<Base title="besta">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- CABECERA: solo el logo -->
  <header class="sticky top-0 z-30 bg-noche/85 backdrop-blur-md border-b border-crema/8">
    <div class="mx-auto max-w-[1240px] px-4 sm:px-6 h-16 flex items-center">
      <a href="#inicio" aria-label="besta, inicio" class="logo-crop w-[104px]"><img src="/img/logo-crema.png" alt="besta" /></a>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section id="inicio" class="mx-auto max-w-[1240px] px-4 sm:px-6 pt-6 sm:pt-8">
      <div class="vig relative overflow-hidden rounded-[28px] sm:rounded-[40px] border-[10px] sm:border-[14px] border-marco min-h-[560px] sm:min-h-[620px] flex items-end">
        <img src="/img/directo/11.jpg" alt="Los seis de besta abrazados de espaldas en el escenario, mirando al público" fetchpriority="high" class="absolute inset-0 size-full object-cover object-[center_60%] sm:object-[center_32%]" />
        <div class="absolute inset-0 bg-gradient-to-b from-transparent from-25% via-noche/70 via-60% to-noche"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-noche/70 to-transparent to-60%"></div>
        <div class="scan absolute inset-0"></div>
        <div class="relative w-full p-6 sm:p-10 flex flex-wrap items-end justify-between gap-8">
          <div class="flex flex-col gap-4 max-w-[620px]">
            <h1 class="text-[clamp(52px,9vw,104px)] font-extrabold leading-[.88] tracking-[-.04em]"><span class="sr-only">besta: </span>sube el volumen.</h1>
            <div class="flex flex-wrap gap-2.5">
              <a href="#escucha" class="inline-flex items-center gap-2.5 h-[52px] px-6 rounded-full bg-crema text-noche font-semibold text-[17px]">
                <svg width="14" height="16" viewBox="0 0 14 16" aria-hidden="true"><path d="M1 1l12 7-12 7z" fill="#0F0B08"/></svg>
                escucha «{single.title}»
              </a>
              <button type="button" data-gallery class="inline-flex items-center h-[52px] px-6 rounded-full border-[1.5px] border-crema/50 bg-noche/40 backdrop-blur font-semibold text-[17px]">fotos del último bolo</button>
            </div>
          </div>
          <div class="w-full sm:w-[340px] rounded-3xl bg-tubo/95 border border-crema/15 p-5 flex flex-col gap-3.5">
            <p class="kicker text-[12px] text-crema/70">próximo concierto</p>
            {next?.g.teaser ? (
              <>
                <div class="flex items-center gap-4">
                  <div class="font-mono text-center leading-none px-3 py-2.5 rounded-2xl border-[1.5px] border-dashed border-senal text-senal">
                    <div class="text-xs">{next.g.teaser.date === "oculta" ? "PRÓX" : mon(next.g.date)}</div>
                    <div class="text-[30px] font-medium mt-1">{next.g.teaser.date === "exacta" ? dayNum(next.g.date) : <span class="blur-[6px] select-none" aria-hidden="true">17</span>}</div>
                  </div>
                  <div class="min-w-0">
                    <div class="text-xl font-semibold">{next.g.city || <><span class="blur-[7px] select-none" aria-hidden="true">Ciudad secreta</span><span class="sr-only">ciudad por desvelar</span></>}</div>
                    <div class="text-[15px] text-crema/70">{next.g.venue || "se desvela pronto"}</div>
                  </div>
                </div>
                <button type="button" data-avisame="fechas" class="h-12 rounded-full bg-senal text-noche font-semibold">avísame cuando se desvele</button>
              </>
            ) : next ? (
              <>
                <div class="flex items-center gap-4">
                  <div class="font-mono text-center leading-none px-3 py-2.5 rounded-2xl bg-senal text-noche"><div class="text-xs">{mon(next.g.date)}</div><div class="text-[30px] font-medium mt-1">{dayNum(next.g.date)}</div></div>
                  <div class="min-w-0"><div class="text-xl font-semibold">{next.g.city}</div><div class="text-[15px] text-crema/70">{next.g.venue} · {next.g.time}</div></div>
                </div>
                {next.own && <button type="button" data-tickets={next.ev!.id} class="h-12 rounded-full bg-senal text-noche font-semibold">comprar entradas · {eur(next.ev!.priceCents)}</button>}
                {next.soldOut && <p class="h-12 rounded-full border-[1.5px] border-senal text-senal font-mono font-medium tracking-[.14em] flex items-center justify-center">SOLD OUT</p>}
                {!next.own && !next.soldOut && next.g.externalUrl && <a href={next.g.externalUrl} target="_blank" rel="noopener" class="h-12 rounded-full bg-senal text-noche font-semibold flex items-center justify-center gap-2">entradas e info <Icon name="externo" size={16} /></a>}
              </>
            ) : (
              <>
                <div class="flex items-center gap-4">
                  <div class="font-mono text-center leading-none px-3 py-2.5 rounded-2xl border-[1.5px] border-dashed border-senal text-senal"><div class="text-xs">PRÓX</div><div class="text-[30px] font-medium mt-1">??</div></div>
                  <div><div class="text-xl font-semibold">por anunciar</div><div class="text-[15px] text-crema/70">Estamos cerrando fechas nuevas.</div></div>
                </div>
                <button type="button" data-avisame="fechas" class="h-12 rounded-full bg-senal text-noche font-semibold">avísame cuando salgan</button>
              </>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- TELETIPO -->
    <div aria-hidden="true" class="mt-10 bg-senal text-noche overflow-hidden -rotate-[1.2deg]">
      <div class="ticker py-3.5 text-[28px] sm:text-[34px] font-extrabold tracking-[-.02em] whitespace-nowrap">
        {[0, 1].map(() => (
          <span class="pr-10 inline-flex items-center gap-[.45em]">
            {ticker.map(t => <>{t}<Icon name="asterisco" size={26} strokeWidth={2.4} /></>)}
          </span>
        ))}
      </div>
    </div>

    <!-- DIRECTO -->
    <section id="directo" class="mx-auto max-w-[1240px] px-4 sm:px-6 pt-24 scroll-mt-16">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-7">
        <div>
          <h2 class="text-[clamp(40px,5vw,64px)] font-bold leading-[.95] tracking-[-.035em]">vente a vernos.</h2>
        </div>
        <p class="max-w-[360px] text-crema/70 leading-relaxed">Entradas directas, sin intermediarios. Te llegan al email con tu QR al momento.</p>
      </div>
      <ul class="border-t border-crema/15">
        {!upcoming.length && (
          <li class="flex flex-wrap items-center gap-x-6 gap-y-3 py-5 px-2 border-b border-crema/15">
            <span class="w-[120px] font-mono text-[15px] tracking-wider text-senal">PRÓXIMAMENTE</span>
            <div class="flex-[1_1_220px] min-w-0">
              <div class="text-[28px] sm:text-[30px] font-bold tracking-[-.02em] leading-tight">nuevas fechas por anunciar</div>
              <div class="text-[15px] text-crema/70">Apúntate y te avisamos antes que a nadie, con preventa.</div>
            </div>
            <button type="button" data-avisame="fechas" class="h-12 min-w-[168px] px-5 rounded-full bg-senal text-noche font-semibold">avísame</button>
          </li>
        )}
        {rows.map(({ g, ev, own, soldOut, past }) => g.teaser ? (
          <li class="flex flex-wrap items-center gap-x-6 gap-y-3 py-5 px-2 border-b border-crema/15">
            <span class="w-[120px] font-mono text-[15px] tracking-wider text-senal">
              {g.teaser.date === "exacta" ? dateLabel(g.date) : <>{secretWhen(g) ?? ""} <span class="blur-[5px] select-none" aria-hidden="true">{secretWhen(g) ? "17" : "SÁB 17 OCT"}</span><span class="sr-only">fecha por desvelar</span></>}
            </span>
            <div class="flex-[1_1_220px] min-w-0">
              <div class="text-[28px] sm:text-[30px] font-bold tracking-[-.02em] leading-tight">{g.city || <><span class="blur-[8px] select-none" aria-hidden="true">Ciudad secreta</span><span class="sr-only">ciudad por desvelar</span></>}</div>
              <div class="text-[15px] text-crema/70">{g.venue ? `${g.venue}${g.time ? ` · ${g.time}` : ""}` : <>{g.time ? `${g.time} · ` : ""}<span class="blur-[5px] select-none" aria-hidden="true">sala misteriosa</span><span class="sr-only">sala por desvelar</span></>}</div>
            </div>
            <span class="font-mono text-xs px-2.5 py-1.5 rounded-full bg-senal/15 text-senal-suave inline-flex items-center gap-1.5"><Icon name="asterisco" size={12} />secreto</span>
            <button type="button" data-avisame="fechas" class="h-12 min-w-[168px] px-5 rounded-full border-[1.5px] border-senal text-senal font-semibold">avísame</button>
          </li>
        ) : (
          <li class="flex flex-wrap items-center gap-x-6 gap-y-3 py-5 px-2 border-b border-crema/15 hover:bg-crema/[.03]">
            <span class="w-[120px] font-mono text-[15px] tracking-wider">{dateLabel(g.date)}</span>
            <div class="flex-[1_1_220px] min-w-0">
              <div class={`text-[28px] sm:text-[30px] font-bold tracking-[-.02em] leading-tight ${past ? "text-crema/70" : ""}`}>{g.city}</div>
              <div class="text-[15px] text-crema/70">{g.venue} · {g.time}</div>
            </div>
            {own && <span class="font-mono text-xs px-2.5 py-1.5 rounded-full bg-senal/15 text-senal-suave inline-flex items-center gap-1.5"><Punto />a la venta</span>}
            {soldOut && <span class="font-mono text-sm font-medium tracking-[.14em] px-3.5 py-2 rounded-full border-[1.5px] border-senal text-senal -rotate-2">SOLD OUT</span>}
            {!own && !soldOut && !past && g.ticketing === "externa" && <span class="font-mono text-xs px-2.5 py-1.5 rounded-full bg-crema/10 text-crema/80">entradas fuera</span>}
            {past && <span class="font-mono text-xs px-2.5 py-1.5 rounded-full bg-crema/5 text-crema/60">pasado</span>}
            {own && <button type="button" data-tickets={ev!.id} class="h-12 min-w-[168px] px-5 rounded-full bg-senal text-noche font-semibold">entradas · {eur(ev!.priceCents)}</button>}
            {!own && !soldOut && g.externalUrl && <a href={g.externalUrl} target="_blank" rel="noopener" class="h-12 min-w-[168px] px-5 rounded-full border-[1.5px] border-crema/40 flex items-center justify-center gap-2 font-medium">más info <Icon name="externo" size={16} /></a>}
          </li>
        ))}
      </ul>
    </section>

    <!-- ESCUCHA -->
    <section id="escucha" class="mx-auto max-w-[1240px] px-4 sm:px-6 pt-28 scroll-mt-16">
      <div class="flex flex-wrap items-center gap-12">
        <div class="relative flex-[1_1_380px]">
          <img src={single.cover} alt={`Portada de ${single.title}: atardecer sobre el mar`} loading="lazy" class="w-full aspect-square object-cover rounded-[28px] -rotate-2 shadow-[0_40px_80px_rgba(0,0,0,.5)]" />
          <span class="absolute -right-2 bottom-6 rotate-[4deg] bg-crema text-noche px-4 py-2.5 rounded-xl font-mono text-[13px] tracking-widest">NUEVO SINGLE</span>
        </div>
        <div class="flex-[1_1_380px] flex flex-col gap-6">
          <h2 class="text-[clamp(44px,6vw,84px)] font-extrabold leading-[.9] tracking-[-.04em]">{single.title.toLowerCase()}</h2>
          <div class="flex flex-wrap gap-2.5">
            {platforms.map((p, i) => (
              <a href={p.url} target="_blank" rel="noopener" class={`h-12 px-5 rounded-full grid place-items-center ${i === 0 ? "bg-senal text-noche font-semibold" : "border-[1.5px] border-crema/30 hover:border-crema/70"}`}>{p.name}</a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- BANDA -->
    <section id="banda" class="mx-auto max-w-[1240px] px-4 sm:px-6 pt-28 scroll-mt-16">
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="vig relative aspect-square rounded-[28px] sm:rounded-[32px] border-[10px] sm:border-[12px] border-marco overflow-hidden">
          <img src="/img/grupo.jpg" alt="Los seis de besta mirando a cámara sobre un fondo naranja" loading="lazy" class="absolute inset-0 size-full object-cover" />
          <div class="scan absolute inset-0"></div>
          <div class="absolute left-4 bottom-4 sm:left-5 sm:bottom-5 flex flex-wrap gap-2">
            <span class="bg-noche px-3 py-2 rounded-[10px] font-mono text-xs tracking-wider">SEIS AMIGOS · BARCELONA</span>
            <button type="button" data-radio class="bg-senal text-noche px-3 py-2 rounded-[10px] font-mono text-xs tracking-wider inline-flex items-center gap-1.5"><Icon name="play" size={12} />ESCUCHAR ENTREVISTA</button>
          </div>
        </div>
        <div class="bg-crema text-noche rounded-[28px] sm:rounded-[32px] p-7 sm:p-8 flex flex-col justify-between gap-6">
          <h2 class="text-[40px] sm:text-[46px] font-extrabold leading-[.92] tracking-[-.035em]">seis amigos, mucha música y muchas ganas.</h2>
          <p class="text-[17px] leading-relaxed">{bio}</p>
          <div class="flex flex-wrap gap-4 font-mono text-[13px]">
            {socials.map(s => <a href={s.url} target="_blank" rel="noopener" class="underline">{s.name}</a>)}
          </div>
        </div>
      </div>
    </section>

    <!-- FOTOS -->
    <section id="fotos" aria-label="Fotos en directo" class="pt-28 scroll-mt-16">
      <div class="mx-auto max-w-[1240px] px-4 sm:px-6 flex flex-wrap items-end justify-between gap-6 mb-7">
        <div>
          <h2 class="text-[clamp(40px,5vw,64px)] font-bold leading-[.95] tracking-[-.035em]">así se vive en directo.</h2>
        </div>
        <a href={socials[0].url} target="_blank" rel="noopener" class="font-mono text-[13px] text-crema/75 hover:text-crema underline inline-flex items-center gap-1.5">más en Instagram <Icon name="externo" size={14} /></a>
      </div>
      <ul class="flex gap-4 overflow-x-auto snap-x snap-mandatory no-scrollbar px-4 sm:px-[max(24px,calc((100vw-1240px)/2+24px))] pb-2">
        {["catxull/08", "directo/05", "directo/08", "directo/07", "directo/04", "directo/10", "directo/02", "directo/11", "directo/12", "directo/13"].map((n, i) => (
          <li class="snap-start shrink-0">
            <div class={`vig relative w-[64vw] sm:w-[300px] aspect-[3/4] rounded-[24px] border-[8px] border-marco overflow-hidden ${i % 2 ? "sm:mt-10" : ""}`}>
              <img src={`/img/${n}.jpg`} alt={`besta en directo, foto ${i + 1}`} loading="lazy" class="size-full object-cover" />
              <div class="scan absolute inset-0"></div>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- MERCH -->
    {merchProducts.length > 0 && <section id="merch" class="mx-auto max-w-[1240px] px-4 sm:px-6 pt-28 scroll-mt-16">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-7">
        <div>
          <h2 class="text-[clamp(40px,5vw,64px)] font-bold leading-[.95] tracking-[-.035em]">llévate algo puesto.</h2>
        </div>
      </div>
      <MerchRequest client:visible products={merchProducts} gigs={pickupGigs} empty={empty} />
    </section>}

    <!-- CONTRATAR -->
    <section id="contratar" class="mx-auto max-w-[1240px] px-4 sm:px-6 pt-28 scroll-mt-16">
      <div class="bg-senal text-noche rounded-[32px] sm:rounded-[40px] p-8 sm:p-16 flex flex-wrap items-end justify-between gap-8">
        <div class="max-w-[680px]">
          <h2 class="text-[clamp(44px,6vw,88px)] font-extrabold leading-[.88] tracking-[-.04em]">¿nos traes a tu ciudad?</h2>
        </div>
        <div class="flex flex-col gap-3 w-full sm:w-auto sm:min-w-[280px]">
          <button type="button" data-contact class="h-14 px-8 rounded-full bg-noche text-crema font-semibold text-[17px]">pedir presupuesto</button>
          <p class="text-center text-[15px] leading-snug">o escríbenos a<br /><a href={`mailto:${contactEmail}?subject=Contrataci%C3%B3n%20besta`} class="font-semibold underline underline-offset-4 decoration-2 break-all">{contactEmail}</a></p>
        </div>
      </div>
    </section>
  </main>

  <!-- PIE -->
  <footer class="mx-auto max-w-[1240px] px-4 sm:px-6 pt-28 pb-12 flex flex-col gap-12">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div id="avisame" class="max-w-[480px] flex flex-col gap-3.5 scroll-mt-24">
        <h2 class="text-[34px] font-bold tracking-[-.02em]">entérate antes que nadie</h2>
        <p class="text-crema/70 leading-relaxed">Preventa de entradas y lanzamientos. Un email cuando hay algo que contar, nada más.</p>
        <div data-newsletter></div>
      </div>
      <span class="logo-crop w-full max-w-[560px] opacity-90" aria-hidden="true"><img src="/img/logo-crema.png" alt="" /></span>
    </div>
    <div class="flex flex-wrap justify-between gap-4 pt-6 border-t border-crema/12 font-mono text-xs text-crema/65">
      <span>© {new Date().getFullYear()} besta · Barcelona</span>
      <div class="flex flex-wrap gap-5">
        <a href="/legal/aviso-legal/" class="hover:text-crema">aviso legal</a>
