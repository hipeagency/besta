---
import Base from "@/layouts/Base.astro";
---
<Base title="no encontrado · besta" noindex>
  <main class="min-h-dvh grid place-items-center px-6">
    <div class="flex flex-col items-center gap-6 text-center">
      <a href="/" class="logo-crop w-32"><img src="/img/logo-crema.png" alt="besta" /></a>
      <p class="kicker text-senal">404 · sin señal</p>
      <h1 class="text-[clamp(44px,8vw,88px)] font-extrabold leading-[.9] tracking-[-.04em]">esta página<br />no existe.</h1>
      <a href="/" class="h-12 px-6 rounded-full bg-senal text-noche font-semibold grid place-items-center">volver a besta.es</a>
    </div>
  </main>
</Base>
